{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/team/bin/session_context.py\"",
            "timeout": 45
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/team/bin/guard_edits.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/team/bin/guard_bash.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git merge origin/main*)",
      "Bash(git rebase origin/main*)",
      "Bash(git rev-parse*)",
      "Bash(git worktree list*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(python3 .claude/team/bin/check_branch.py*)",
      "Bash(.venv/bin/python -m pytest*)",
      "Bash(.venv/bin/python -m compileall*)",
      "Bash(.venv/bin/python -m kravein*)",
      "Bash(.claude/team/bin/team status*)",
      "Bash(.claude/team/bin/team up*)",
      "Bash(.claude/team/bin/team down*)",
      "Bash(.claude/team/bin/team send*)",
      "Bash(tmux list-windows*)",
      "Bash(tmux capture-pane*)",
      "Bash(.venv/bin/python tools/*)",
      "Bash(git push -u origin agent/*)",
      "Bash(git push origin agent/*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue create*)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(cd web && npm run build*)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(bash -n *)",
      "Bash(python3 .claude/team/tests/*)",
      "Bash(ls*)",
      "Bash(grep*)",
      "Bash(wc*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(cat *)",
      "Bash(sed -n *)",
      "Bash(sort*)",
      "Bash(uniq*)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(.venv/bin/python -m pyflakes*)",
      "Bash(.venv/bin/python -m pytest --collect-only*)",
      "Bash(brahma-connect-android/gradlew *)",
      "Bash(android/gradlew *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
