[Unit]
Description=Brahma Echo — Linux system assistant
Documentation=file:%h/code/Brahma-Echo/README-LINUX.md
# A user service, not a system one: the assistant needs the session bus,
# the compositor socket, PipeWire and the user's own file permissions.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# %h expands to the user's home. Adjust WorkingDirectory if you cloned
# the repository somewhere else.
WorkingDirectory=%h/code/Brahma-Echo
ExecStart=%h/code/Brahma-Echo/.venv/bin/python -m brahma daemon

Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# Keep the assistant's own logs out of the audit trail's way.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=brahma-echo

# Credentials come from the environment so they never land in the unit file.
# Create %h/.config/brahma-echo/env with:
#   BRAHMA_GEMINI_API_KEY=...
#   BRAHMA_OPENROUTER_API_KEY=...
EnvironmentFile=-%h/.config/brahma-echo/env

# The assistant is a system controller, so it cannot be locked down the way
# a network daemon would be. These are the restrictions that still hold
# without breaking its actual job.
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# Deliberately NOT set: ProtectSystem / ProtectHome / PrivateTmp — the whole
# point of this service is to manage the user's files and applications.

[Install]
WantedBy=graphical-session.target
